# API process uses ONLY this restricted reader account.
COPILOT_DATABASE_URL=postgresql://credit_copilot_reader:reader_local@127.0.0.1:5434/copilot
COPILOT_PROVIDER=demo
COPILOT_LLM_API_STYLE=chat_completions
COPILOT_LLM_BASE_URL=https://api.openai.com/v1
# Set model ID and key locally to activate live LLM mode. Never paste keys into chat.
COPILOT_LLM_MODEL=
COPILOT_LLM_API_KEY=
COPILOT_AUDIT_PATH=runtime/audit.sqlite3
COPILOT_MAX_ROWS=200
COPILOT_MAX_ATTEMPTS=3
COPILOT_STATEMENT_TIMEOUT_MS=1500
COPILOT_API_URL=http://127.0.0.1:8001
# Administrative credentials are used only by the CLI initialization command.
# Do not pass them to the API container.
# COPILOT_ADMIN_URL=postgresql://copilot_admin:admin_local@127.0.0.1:5434/copilot
# COPILOT_READER_PASSWORD=reader_local
# Optional Docker-only override for connecting API to a different PostgreSQL database:
# COPILOT_TARGET_DATABASE_URL=postgresql://credit_copilot_reader:password@host.docker.internal:5433/creditdesk
